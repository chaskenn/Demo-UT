#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

&Перед("ОбработкаПроведения")
Процедура Учеб_ОбработкаПроведения(Отказ, РежимПроведения)
	
	Учеб_ПроверитьКомментарийКрупнойЗакупки(Отказ);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Запрещает проведение закупки в валюте с цифровым кодом 643,
// если сумма документа от 100 000 и комментарий не заполнен.
//
Процедура Учеб_ПроверитьКомментарийКрупнойЗакупки(Отказ)
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	// Цифровой код 643 - код российского рубля в справочнике Валюты.
	ВалютаРубль = Справочники.Валюты.НайтиПоКоду("643");
	Если Не ЗначениеЗаполнено(ВалютаРубль)
		Или Валюта <> ВалютаРубль Тогда
		Возврат;
	КонецЕсли;
	
	ПорогСуммыКрупнойЗакупки = 100000;
	Если СуммаДокумента < ПорогСуммыКрупнойЗакупки Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ПустаяСтрока(СокрЛП(Комментарий)) Тогда
		Возврат;
	КонецЕсли;
	
	ТекстСообщения = НСтр("ru = 'Для закупки на сумму от 100 000 руб. укажите причину в поле ""Комментарий"".'");
	ОбщегоНазначения.СообщитьПользователю(
		ТекстСообщения,
		ЭтотОбъект,
		"Комментарий",
		,
		Отказ);
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли
