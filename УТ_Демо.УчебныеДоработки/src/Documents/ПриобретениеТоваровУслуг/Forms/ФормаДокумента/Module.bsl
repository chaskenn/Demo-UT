
&НаСервере
&После("ПриСозданииНаСервере")
Процедура Учеб_ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если Отказ Тогда
		Возврат;
	КонецЕсли;

	Если Элементы.Найти("Учеб_НомерЗаявкиПоставщику") <> Неопределено Тогда
		Возврат;
	КонецЕсли;

	ПолеНомераЗаявки = Элементы.Добавить(
		"Учеб_НомерЗаявкиПоставщику",
		Тип("ПолеФормы"),
		Элементы.ГруппаПараметрыЛево);

	ПолеНомераЗаявки.Вид = ВидПоляФормы.ПолеВвода;
	ПолеНомераЗаявки.ПутьКДанным = "Объект.Учеб_НомерЗаявкиПоставщику";
	ПолеНомераЗаявки.Заголовок = НСтр("ru = 'Номер заявки поставщику'");

	Элементы.Переместить(
		ПолеНомераЗаявки,
		Элементы.ГруппаПараметрыЛево,
		Элементы.Сделка);

КонецПроцедуры