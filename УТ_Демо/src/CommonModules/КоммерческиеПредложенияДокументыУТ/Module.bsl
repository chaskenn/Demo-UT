	Объект = Форма.Объект;
	
	ПараметрыРасчета = Новый Структура;
	ПараметрыРасчета.Вставить("ПрименятьКОбъекту",                Ложь);
	ПараметрыРасчета.Вставить("ТолькоПредварительныйРасчет",      Истина);
	ПараметрыРасчета.Вставить("ВосстанавливатьУправляемыеСкидки", Истина);
	ПараметрыРасчета.Вставить("УправляемыеСкидки",                Форма.УправляемыеСкидки);
	ПараметрыРасчета.Вставить("ИмяКолонкиУпаковка",               "ЕдиницаИзмерения");
